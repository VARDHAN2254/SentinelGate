# ==============================================================================
# SentinelGate — Environment Configuration Template
# Copy this file to .env and replace placeholder values before deployment.
# DO NOT commit production .env files to version control.
# ==============================================================================

# Database Credentials
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sentinelgate_db
SPRING_DATASOURCE_USERNAME=sentinelgate_user
SPRING_DATASOURCE_PASSWORD=sentinelgate_password

# Redis Credentials
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# JWT Security
# Generate a strong 512-bit Base64-encoded secret for production
JWT_SECRET=c2VudGluZWxnYXRlX3NlY3VyZV9hcGlfZ2F0ZXdheV9zdXBlcl9zZWNyZXRfa2V5X2Zvcl9qc3RfMmU4YjRhOTM2YzE1ZmQ0ZWNmOGE3ZDI5YjM0MTY3Y2Q=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Default Administrator Seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecret123!

# Grafana Monitoring
GF_SECURITY_ADMIN_PASSWORD=admin
